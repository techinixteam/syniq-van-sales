<resources>

    <!--
      Base application theme.

      ⚠ `android:windowBackground` IS THE FIX FOR THE BLACK LAUNCH SCREEN. Without it,
      `Theme.AppCompat.DayNight` resolves its default window background to near-black on a
      night-mode device, and that is what the user stares at from the moment the activity is
      created until React Native paints its first frame. On a debug build pulling the bundle from
      Metro over USB that is several seconds, and it reads as "the app is broken".

      `windowDisablePreview` is deliberately NOT set: the preview window is exactly what we want,
      now that it has something branded to show.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

</resources>
