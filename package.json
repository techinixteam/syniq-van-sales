{
  "name": "syniq-van-sales",
  "version": "0.1.0",
  "description": "SYNIQ Van Sales — Android app for B2B van sales reps (invoicing from the van, quotations, van stock, DC stock)",
  "main": "index.js",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "build": "cd android && gradlew.bat assembleRelease",
    "build:android": "cd android && gradlew.bat assembleRelease",
    "build:android:bundle": "cd android && gradlew.bat bundleRelease",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "perms:sync": "node scripts/sync-permissions.mjs",
    "perms:check": "node scripts/sync-permissions.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run tokens:check && npm run perms:check && npm run brand:check",
    "clean:android": "cd android && gradlew.bat clean && cd ..",
    "clean:cache": "npx react-native start --reset-cache",
    "rebuild:android": "npm run clean:android && npm run android",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "7.3.8",
    "@react-navigation/native-stack": "7.17.10",
    "i18next": "^25.2.1",
    "lucide-react-native": "^1.38.0",
    "react": "19.2.3",
    "react-i18next": "^15.4.1",
    "react-native": "0.85.3",
    "react-native-blob-util": "0.25.1",
    "react-native-gesture-handler": "3.0.2",
    "react-native-keychain": "10.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-share": "12.3.1",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^29.0.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
